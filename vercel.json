{
  "redirects": [
    {
      "source": "/news",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/bertanya",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/bertanya/:slug",
      "destination": "/blog/:slug",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/muhamad-abduh.vcf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/vcard; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"Muhamad-Abduh.vcf\""
        }
      ]
    },
    {
      "source": "/rss.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/rss+xml; charset=utf-8"
        }
      ]
    }
  ]
}
